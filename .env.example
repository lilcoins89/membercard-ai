# Copy to .env.local and fill in values. Never commit real secrets.

# --- App ---
# Public base URL used for Stripe redirect URLs (falls back to the request origin).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon Postgres) ---
# src/lib/db.ts uses the first one that is set, in this order:
# PRISMA_DATABASE_URL_2, PRISMA_DATABASE_URL, POSTGRES_URL, DATABASE_URL.
# `db:push` uses PRISMA_DATABASE_URL_2 only.
PRISMA_DATABASE_URL_2=
PRISMA_DATABASE_URL=
POSTGRES_URL=
DATABASE_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Solana (Helius) ---
# Either HELIUS_RPC (full RPC URL) or HELIUS_API (API key) enables payment verification.
HELIUS_RPC=
HELIUS_API=

# --- Fulfillment ---
# "custom" for production; "mock" only with FULFILLMENT_TEST_MODE=true outside production.
FULFILLMENT_PROVIDER=custom
FULFILLMENT_TEST_MODE=
FULFILLMENT_API_URL=
FULFILLMENT_API_KEY=
# Optional provider base URL override (takes precedence over FULFILLMENT_API_URL).
PRODIGI_API=

# --- Pricing (cents) ---
CARD_PRICE_CENTS=199
FULFILLMENT_MARKUP_CENTS=0
SHIPPING_MARKUP_CENTS=0

# --- Supabase (src/lib/supabase/*) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Documented but not currently read by src/ ---
GROQ_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ADMIN_EMAILS=
